<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. Allows plain HTTP to a local la-carte API (dev + E2E). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The App Group shared with the widget (spec 007), read by AppGroup.id (LaCarteKit/APIClient). -->
	<key>LaCarteAppGroup</key>
	<string>$(LA_CARTE_APP_GROUP)</string>
</dict>
</plist>
