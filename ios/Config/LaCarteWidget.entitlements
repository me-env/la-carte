<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same App Group as the app (spec 007): reads its settings suite and the token's keychain access group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(LA_CARTE_APP_GROUP)</string>
	</array>
</dict>
</plist>
