build/
*.p8
*.p12
*.ipa
*.mobileprovision
# Per-developer signing (team + bundle ID prefix), see ios/Config/Signing.local.xcconfig.example
ios/Config/Signing.local.xcconfig
# Claude Code local state
.claude/settings.local.json
.claude/scheduled_tasks.lock
