.DS_Store
# Xcode
xcuserdata/
DerivedData/
*.xcresult
ios/LaCarteKit/.build/
ios/LaCarteKit/.swiftpm/
# Python
api/.venv/
__pycache__/
*.db
*.sqlite*
.env*
!.env.example
# QA artifacts (screenshots are reviewed, then kept only via reports)
qa/.results/
qa/screenshots/*
!qa/screenshots/.gitkeep
# Third-party design references (downloaded with scripts/fetch-design-refs.sh)
docs/design/reference/
# Apple app icons for the home-screen mock (scripts/design-review.py --home; Apple trademarks, never commit)
docs/design/reference/home-icons/

# CI build output (archives, ipa, decoded keys)
build/
*.p8
*.p12
*.ipa
*.mobileprovision
# Per-developer signing (team + bundle ID prefix), see ios/Config/Signing.local.xcconfig.example
ios/Config/Signing.local.xcconfig
# Claude Code local state
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Per-machine script settings (scratch dir on an external disk)
scripts/.local.env
# Logo exploration outputs (regenerable from each round's render.py): only README, render.py and the 2–3 final
# candidate PNGs are committed (force-add those with `git add -f`).
docs/design/brand/explorations/round9/**
!docs/design/brand/explorations/round9/render.py
!docs/design/brand/explorations/round9/README.md
docs/design/brand/explorations/*/frames/
docs/design/brand/explorations/*/*.npy
docs/design/brand/explorations/round10/**
!docs/design/brand/explorations/round10/render.py
!docs/design/brand/explorations/round10/README.md
docs/design/brand/explorations/round11/**
!docs/design/brand/explorations/round11/render.py
!docs/design/brand/explorations/round11/README.md
